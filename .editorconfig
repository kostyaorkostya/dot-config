root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.sh]
max_line_length = 80
binary_next_line = true
switch_case_indent = true

[*.py]
indent_size = 4
max_line_length = 80

[*.vim]
max_line_length = 80

[*.lua]
max_line_length = 120

[*.xml]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[gdb/gdb-dashboard]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
